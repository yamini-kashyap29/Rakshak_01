# Copy this file to .env and adjust as needed. All values shown are the
# built-in defaults — RescueGrid runs fully functional with no .env at all.

# Master switch for live external data (weather + earthquakes). Set to
# "false" to run entirely on seeded/simulated data (e.g. offline demo).
LIVE_DATA_ENABLED=true

# How often (seconds) the backend refreshes weather + earthquake data in
# the background. Requests always read the cached value — this interval
# does not add latency to any API call.
WEATHER_REFRESH_SECONDS=60

# Only earthquakes within this radius (km) of the disaster scenario's
# center are kept/shown.
EARTHQUAKE_RADIUS_KM=500

# "osrm" enables best-effort real driving-route refinement via the public
# OSRM demo server for map display. Any other value (e.g. "simulated")
# disables it — the deterministic named-road routing model is unaffected
# either way, since it never depends on this setting.
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org

# No API keys are required for Open-Meteo, USGS, or the public OSRM demo
# server. If you later swap in a paid/rate-limited provider, add its key
# here — never hardcode it in source.
